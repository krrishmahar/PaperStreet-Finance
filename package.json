{
  "name": "arham-fintech-bse-dashboard",
  "version": "1.0.0",
  "description": "Real-time BSE trade ingestion & dashboard with 30s timeout resilience",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:server": "npx tsx src/server.ts",
    "dev:mock": "npx tsx src/bse-mock/server.ts",
    "dev:all": "concurrently \"next dev -p 3001\" \"npx tsx src/server.ts\" \"npx tsx src/bse-mock/server.ts\"",
    "build": "next build",
    "start": "next start -p 3001",
    "bse:mock": "npx tsx src/bse-mock/server.ts",
    "server": "npx tsx src/server.ts",
    "db:migrate": "npx tsx src/db/migrate.ts",
    "db:flush": "npx tsx src/db/flush.ts",
    "test:ui": "node load-tests/playwright_nextjs_ui_test.mjs",
    "test:ui:headed": "node load-tests/playwright_nextjs_ui_test.mjs --headed",
    "test:e2e": "node load-tests/playwright_nextjs_ui_test.mjs",
    "test:chaos": "node load-tests/chaos-e2e.spec.mjs",
    "test:load": "npx artillery run load-tests/load-test.yml"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "@vercel/analytics": "^1.6.1",
    "bullmq": "^5.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "opossum": "^10.0.0",
    "pg": "^8.11.5",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.17.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
